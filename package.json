{
  "name": "shengchang-ai-drama-studio",
  "version": "0.1.0",
  "description": "Personal AI radio-drama workbench — paste a novel, get a directed, mixed episode. 个人 AI 多人广播剧制作工作台：小说进，成片出。",
  "license": "MIT",
  "keywords": [
    "tts",
    "radio-drama",
    "audiobook",
    "ffmpeg",
    "doubao"
  ],
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c yellow,cyan \"npm run server\" \"vite --host 127.0.0.1 --port 4173\"",
    "server": "node --watch server/index.js",
    "start": "node server/index.js",
    "test": "node --test server/*.test.js",
    "test:e2e": "node scripts/e2e.mjs",
    "seed": "node scripts/seed-sample.mjs",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^6.0.5",
    "concurrently": "^10.0.4",
    "express": "^5.2.1",
    "lucide-react": "^1.28.0",
    "vite": "^8.2.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {},
  "engines": {
    "node": ">=22.5"
  }
}
